# Берем список с двузначными числами, чтобы поразрядная сортировка работала наглядно
numbers = [42, 15, 8, 23, 9, 31, 4]

print("--- №4 ПРОЧЕСЫВАНИЕМ ---")
comb_sort(numbers.copy())

print("--- №5 ВСТАВКАМИ ---")
insertion_sort(numbers.copy())

print("--- №6 ВЫБОРОМ ---")
selection_sort(numbers.copy())

print("--- №7 ШЕЛЛА ---")
shell_sort(numbers.copy())

print("--- №8 ПОРАЗРЯДНАЯ ---")
radix_sort(numbers.copy())

print("--- №9 ПИРАМИДАЛЬНАЯ ---")
heap_sort(numbers.copy())
